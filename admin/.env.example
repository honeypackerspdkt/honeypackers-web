# Google Drive backup (see CLAUDE.md → "Google Drive backup"). Public client ids, not secrets.
# Copy to .env.local and fill in. Leave a line empty to turn Drive off on that platform.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_ANDROID_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# Cloud sync (see supabase/README.md). The anon key is public; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Website with the payment server functions (Razorpay payment links), e.g. https://honeypackers.in
VITE_SHOP_URL=
