# Business details shown on the site (until they come from BoxBook's Company profile via Supabase).
PUBLIC_BUSINESS_NAME=Honey Packers
PUBLIC_BUSINESS_TAGLINE=Corrugated boxes made to your size
PUBLIC_BUSINESS_PHONE=
# WhatsApp number with country code, no + or spaces, e.g. 919876543210
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_BUSINESS_EMAIL=
PUBLIC_BUSINESS_ADDRESS=
PUBLIC_BUSINESS_CITY=
PUBLIC_BUSINESS_GSTIN=
PUBLIC_GRIEVANCE_OFFICER=

# Live prices: Supabase project of BoxBook (anon key is public; RLS limits it to the price list).
# Leave empty to use src/data/sample-price-list.json (the site then shows "sample prices").
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SHOP_ORG_ID=

# Ads (hub web-growth): Meta Pixel + Conversions API
PUBLIC_SITE_KEY=honeypackers
PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# Online payment (Razorpay) + server functions. Server-only values: set them in Netlify, never with a PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
