---
import Base from '../layouts/Base.astro';
---

<Base
  title="Corrugated box strength (BS) and weight calculator"
  description="Free calculator: enter box size, ply and the GSM and BF of each paper layer to get bursting strength (BS), box weight, board sheet (cut) size and deckle."
>
  <section class="section" style="padding-top:32px">
    <div class="container">
      <h1>Box strength calculator</h1>
      <p class="section__intro">Compare papers before you order. Enter the box size and the GSM and BF of each layer to see bursting strength (BS), weight and board sheet size. Free to use, nothing to sign up for.</p>

      <div class="config" data-strength>
        <form class="config__panel" onsubmit="return false" data-form>
          <div class="card form-grid">
            <h2 style="font-size:1.2rem;margin:0">Box size (inside, mm)</h2>
            <div class="form-grid form-grid--3">
              <label class="field"><span>Length</span><span class="input-unit"><input name="length" type="number" inputmode="decimal" min="1" value="300" /><em>mm</em></span></label>
              <label class="field"><span>Width</span><span class="input-unit"><input name="width" type="number" inputmode="decimal" min="1" value="200" /><em>mm</em></span></label>
              <label class="field"><span>Height</span><span class="input-unit"><input name="height" type="number" inputmode="decimal" min="1" value="150" /><em>mm</em></span></label>
            </div>
            <div class="chips" role="radiogroup" aria-label="Ply">
              {[3, 5, 7, 9].map((p) => <label><input type="radio" name="ply" value={p} checked={p === 3} /><span>{p} ply</span></label>)}
            </div>
          </div>
          <div class="card form-grid">
            <h2 style="font-size:1.2rem;margin:0">Paper in each layer</h2>
            <div class="form-grid" data-layers></div>
            <p class="small muted" style="margin:0">Fluted layers use about 40% more paper (take-up 1.4) and count half towards BS.</p>
          </div>
        </form>
        <aside class="config__aside" aria-live="polite">
          <div class="card">
            <p class="muted small" style="margin:0 0 4px">Bursting strength</p>
            <p class="price-big" style="margin:0 0 16px"><span data-bs>—</span> <small>kg/cm²</small></p>
            <dl class="kv">
              <dt>Weight per box</dt><dd data-weight>—</dd>
              <dt>Board sheet (cut size)</dt><dd data-cut>—</dd>
              <dt>Deckle</dt><dd data-deckle>—</dd>
            </dl>
            <div class="btn-row" style="margin-top:18px">
              <a class="btn btn--primary" href="/custom-box/" data-price-link>See the price</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container prose">
      <h2>How it is calculated</h2>
      <p><strong>Cut size</strong> = 2 × length + 2 × width + 50 mm. Above 1,600 mm the box is made from two sheets of length + width + 50 mm. <strong>Deckle</strong> = width + height + 20 mm (30 mm for 7 ply, 50 mm for 9 ply).</p>
      <p><strong>Weight</strong> = sheet area × GSM of every layer, with fluted layers × 1.4. <strong>BS</strong> = Σ GSM × BF ÷ 1000 over the layers, fluted layers counted at half.</p>
    </div>
  </section>
</Base>

<script>
  import { calcBox, emptyLayers, layerName, isFlute } from '@honeypackers/box-core/calc';
  import type { BoxSpec, Ply } from '@honeypackers/box-core/types';

  const form = document.querySelector<HTMLFormElement>('[data-strength] [data-form]')!;
  const layersBox = document.querySelector<HTMLElement>('[data-layers]')!;
  const fmt = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 2 });
  const remembered = emptyLayers().map(() => ({ gsm: 120, bf: 18 }));

  const ply = () => Number(new FormData(form).get('ply')) as Ply;
  const renderLayers = () => {
    const n = ply();
    layersBox.innerHTML = Array.from({ length: n }, (_, i) => `
      <div class="form-grid form-grid--2" style="align-items:end">
        <label class="field"><span>${layerName(i, n)}${isFlute(i) ? ' <small>(fluted)</small>' : ''}</span>
          <span class="input-unit"><input name="gsm${i}" type="number" inputmode="numeric" min="0" value="${remembered[i].gsm}" aria-label="${layerName(i, n)} GSM" /><em>GSM</em></span></label>
        <label class="field"><span class="visually-hidden">${layerName(i, n)} BF</span>
          <span class="input-unit"><input name="bf${i}" type="number" inputmode="numeric" min="0" value="${remembered[i].bf}" aria-label="${layerName(i, n)} BF" /><em>BF</em></span></label>
      </div>`).join('');
  };

  const update = () => {
    const fd = new FormData(form);
    const n = ply();
    const layers = emptyLayers();
    for (let i = 0; i < n; i++) {
      // A layer's fields may not exist yet (the ply was just changed): keep what was typed before.
      const gsm = fd.get(`gsm${i}`);
      const bf = fd.get(`bf${i}`);
      if (gsm !== null) remembered[i] = { ...remembered[i], gsm: Number(gsm || 0) };
      if (bf !== null) remembered[i] = { ...remembered[i], bf: Number(bf || 0) };
      layers[i] = { ...remembered[i], price: 0 };
    }
    const spec: BoxSpec = { length: Number(fd.get('length') || 0), width: Number(fd.get('width') || 0), height: Number(fd.get('height') || 0), ply: n, perLayer: true, layers };
    const r = calcBox(spec);
    const ok = spec.length > 0 && spec.width > 0 && spec.height > 0;
    const set = (sel: string, v: string) => (document.querySelector(sel)!.textContent = ok ? v : '—');
    set('[data-bs]', fmt.format(r.bs));
    set('[data-weight]', `${fmt.format(r.weight)} g`);
    set('[data-cut]', `${fmt.format(r.cutSize)} mm${r.sheets > 1 ? ' × 2 sheets' : ''}`);
    set('[data-deckle]', `${fmt.format(r.deckleSize)} mm`);
    document.querySelector<HTMLAnchorElement>('[data-price-link]')!.href = `/custom-box/?l=${spec.length}&w=${spec.width}&h=${spec.height}`;
  };

  form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'ply') renderLayers();
    update();
  });
  form.addEventListener('input', update);
  renderLayers();
  update();
</script>
