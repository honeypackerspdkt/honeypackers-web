---
import Base from '../layouts/Base.astro';
import { BOX_W, BOX_H, boxSvgInner } from '../lib/box-svg';
import { loadProducts } from '../lib/products';
import { liveConfig } from '../lib/price-list';
import { productTile } from '../lib/product-card';
import { productHref } from '../lib/catalog';
import { icon } from '../lib/icons';
import { site, waHref } from '../site';

const heroBox = { length: 400, width: 300, height: 250 };
const { products } = await loadProducts(liveConfig());
const built = new Set(products.map((p) => p.slug));
const featured = products.slice(0, 4);

const cats = [
  { href: '/shop/?ply=3', title: '3 ply boxes', text: 'Light goods, retail and e-commerce parcels', icon: icon.box(28) },
  { href: '/shop/?ply=5', title: '5 ply boxes', text: 'Heavier goods and warehouse stacking', icon: icon.layers(28) },
  { href: '/shop/?ply=7', title: '7 ply boxes', text: 'Heavy, fragile and export loads', icon: icon.shield(28) },
  { href: '/custom-box/', title: 'Custom size & print', text: 'Your size, your logo, priced instantly', icon: icon.print(28) },
];

const faqs = [
  { q: 'What is the minimum order?', a: 'The box price page shows the minimum quantity for online prices. For smaller quantities, send an enquiry and we will tell you what we can do.' },
  { q: 'Which size should I give you?', a: 'Give the inside size in millimetres: length and width of the opening, then the height. Allow a few mm around your product for packing.' },
  { q: 'How do I choose 3, 5 or 7 ply?', a: 'Light goods up to a few kg usually travel well in 3 ply. Heavier goods, stacking in warehouses or long transport need 5 ply. Very heavy or export loads need 7 ply. The price page shows the bursting strength (BS) of every option.' },
  { q: 'Is GST included?', a: 'Prices are shown before GST. Corrugated boxes carry 5% GST (HSN 4819), added on the invoice. Give your GSTIN and you can claim input tax credit.' },
  { q: 'Can you print our logo?', a: 'Yes, up to 4 colours. Choose the number of colours on the price page; the plate cost is already included in the price.' },
];
---

<Base
  title={`${site.name}: buy corrugated boxes online`}
  description="Shop 3, 5 and 7 ply corrugated boxes in packs, or price any custom size and printing instantly. Strength (BS) shown, GST invoice, secure online payment."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }}
>
  <section class="hero2">
    <div class="container hero__grid">
      <div>
        <span class="hero__eyebrow">Corrugated box manufacturer</span>
        <h1>Boxes ready to ship, or made to your size.</h1>
        <p class="hero__lead">Order ready sizes in packs, or enter any size and see the price, strength and weight in seconds. Pay online and get a GST invoice.</p>
        <div class="btn-row" style="margin-top:22px">
          <a class="btn btn--primary" href="/shop/">Shop boxes</a>
          <a class="btn btn--ghost" href="/custom-box/">Get a custom size</a>
        </div>
        <ul class="hero__points" style="margin-top:22px">
          <li><Fragment set:html={icon.check(18)} />3, 5 and 7 ply, plain or printed</li>
          <li><Fragment set:html={icon.check(18)} />Bursting strength (BS) shown for every box</li>
          <li><Fragment set:html={icon.check(18)} />UPI, cards and net banking</li>
        </ul>
      </div>
      <a class="hero__visual box3d" href="/custom-box/" aria-label="Price a custom box">
        <svg viewBox={`0 0 ${BOX_W} ${BOX_H}`} aria-hidden="true" set:html={boxSvgInner(heroBox, { yaw: -0.62, pitch: 0.5 })} />
      </a>
    </div>
  </section>

  <section class="section" style="padding-bottom:0">
    <div class="container">
      <div class="cats">
        {cats.map((c) => (
          <a class="cat" href={c.href}>
            <Fragment set:html={c.icon} />
            <strong>{c.title}</strong>
            <span>{c.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section" data-featured data-built={JSON.stringify([...built])}>
      <div class="container">
        <div class="section-head">
          <h2>Ready to order</h2>
          <a href="/shop/">View all boxes →</a>
        </div>
        <div class="tiles" data-tiles set:html={featured.map((p) => productTile(p, productHref(p, built))).join('')} />
      </div>
    </section>
  )}

  <section class="section section--tint">
    <div class="container">
      <div class="custom-band">
        <div>
          <h2>Any size, priced in seconds</h2>
          <p class="muted">Enter the inside length, width and height, choose the board and printing, and see the price per box, how much you save on bigger orders, the strength and the weight. Order and pay online.</p>
          <ol class="steps" style="grid-template-columns:1fr;gap:10px;margin:16px 0 20px">
            <li style="padding:14px"><h3 style="font-size:1rem">Enter your size</h3></li>
            <li style="padding:14px"><h3 style="font-size:1rem">Pick board and printing</h3></li>
            <li style="padding:14px"><h3 style="font-size:1rem">See the price and pay</h3></li>
          </ol>
          <a class="btn btn--primary" href="/custom-box/">Price your custom box</a>
        </div>
        <div class="box3d"><svg viewBox={`0 0 ${BOX_W} ${BOX_H}`} aria-hidden="true" set:html={boxSvgInner({ length: 300, width: 200, height: 150 }, { yaw: -0.9, pitch: 0.45 })} /></div>
      </div>
    </div>
  </section>

  <section class="section faq">
    <div class="container prose">
      <h2>Questions</h2>
      {faqs.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
      {site.whatsapp && <p style="margin-top:18px">Something else? <a href={waHref(site.whatsapp, `Hi ${site.name}, I have a question about boxes.`)} data-wa="faq">Ask us on WhatsApp</a>.</p>}
    </div>
  </section>
</Base>

<script>
  import { catalog, productHref } from '../lib/catalog';
  import { productTile } from '../lib/product-card';
  import { wireTiles } from '../lib/add-to-cart';
  const box = document.querySelector<HTMLElement>('[data-featured]');
  if (box) {
    const tiles = box.querySelector<HTMLElement>('[data-tiles]')!;
    const built = new Set<string>(JSON.parse(box.dataset.built || '[]'));
    wireTiles(tiles);
    void catalog().then((r) => {
      if (r.source === 'live') tiles.innerHTML = r.products.slice(0, 4).map((p) => productTile(p, productHref(p, built))).join('');
    });
  }
</script>
