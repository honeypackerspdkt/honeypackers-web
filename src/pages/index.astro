---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { BOX_W, BOX_H, boxSvgInner, cartonData } from '../lib/box-svg';
import { loadProducts } from '../lib/products';
import { liveConfig } from '../lib/price-list';
import { productTile } from '../lib/product-card';
import { productHref } from '../lib/catalog';
import { site, waHref } from '../site';
import { icon } from '../lib/icons';
import '../styles/home.css';

const { products } = await loadProducts(liveConfig());
const built = new Set(products.map((p) => p.slug));
const featured = products.slice(0, 4);
const words = site.name.toUpperCase().split(/\s+/);

const plies = new Set(products.map((p) => p.ply));
/** Shop filter when ready boxes of that ply exist, otherwise the box builder. */
const plyHref = (n: number) => (plies.has(n as 3 | 5 | 7) ? `/shop/?ply=${n}` : '#configure');

type Link = { href: string; preset?: boolean; style?: string; print?: string; dims: { length: number; width: number; height: number }; yaw: number };
const promos: (Link & { tone: string; kicker: string; title: string; cta: string })[] = [
  { tone: 'orange', kicker: 'Ready sizes', title: 'Corrugated boxes in ready packs', cta: 'Shop boxes', href: '/shop/', dims: { length: 400, width: 300, height: 250 }, yaw: -0.62 },
  { tone: 'cream', kicker: '1 colour or multicolour', title: 'Custom printed boxes, priced instantly', cta: 'Start customising', href: '#configure', preset: true, print: '1', dims: { length: 300, width: 300, height: 300 }, yaw: -0.5 },
  { tone: 'brown', kicker: 'Built for heavy loads', title: 'Export boxes in 5 and 7 ply', cta: 'Get a quote', href: '#quote', dims: { length: 500, width: 400, height: 400 }, yaw: -0.75 },
];

const cats: (Link & { name: string; note: string })[] = [
  { name: '3 ply boxes', note: 'Light goods and e-commerce parcels', href: plyHref(3), dims: { length: 250, width: 200, height: 120 }, yaw: -0.6 },
  { name: '5 ply boxes', note: 'Heavier goods and warehouse stacking', href: plyHref(5), dims: { length: 400, width: 300, height: 250 }, yaw: -0.7 },
  { name: '7 ply & export', note: 'Very heavy and export loads', href: plyHref(7), dims: { length: 500, width: 400, height: 400 }, yaw: -0.55 },
  { name: 'Die-cut mailers', note: 'Neat mailer boxes for products you ship', href: '#configure', preset: true, style: 'diecut', dims: { length: 320, width: 240, height: 90 }, yaw: -0.85 },
  { name: 'Printed boxes', note: 'Your brand on the box', href: '#configure', preset: true, print: '1', dims: { length: 300, width: 300, height: 300 }, yaw: -0.5 },
  { name: 'Custom size', note: 'Any inside size, priced instantly', href: '/custom-box/', dims: { length: 600, width: 200, height: 200 }, yaw: -0.65 },
];

const checklist = ['Live 3D preview and instant price', 'Any inside size, in mm or inch', '3, 5 or 7 ply with the strength (BS) shown', 'Plain, 1 colour or multicolour, with your logo placed where you want'];

const badges = [
  { icon: icon.ruler(22), t: 'Any size made to order', s: 'Priced instantly online' },
  { icon: icon.receipt(22), t: 'GST invoice', s: 'With every order' },
  { icon: icon.shield(22), t: 'Secure online payment', s: 'UPI, card or net banking' },
  { icon: icon.truck(22), t: 'Delivered to you', s: 'Our vehicle or courier' },
];

const faqs = [
  { q: 'What is the minimum order?', a: 'The box builder shows the minimum quantity for online prices. For smaller quantities, send an enquiry and we will tell you what we can do.' },
  { q: 'Which size should I give you?', a: 'Give the inside size in millimetres: length and width of the opening, then the height. Allow a few mm around your product for packing.' },
  { q: 'How do I choose 3, 5 or 7 ply?', a: 'Light goods up to a few kg usually travel well in 3 ply. Heavier goods, stacking in warehouses or long transport need 5 ply. Very heavy or export loads need 7 ply. The price page shows the bursting strength (BS) of every option.' },
  { q: 'Is GST included?', a: 'Prices are shown before GST. Corrugated boxes carry 5% GST (HSN 4819), added on the invoice. Give your GSTIN and you can claim input tax credit.' },
  { q: 'Can you print our logo?', a: 'Yes, up to 4 colours. Choose the number of colours in the box builder; the plate cost is already included in the price.' },
];
---

<Base
  title={`${site.name}: corrugated boxes, ready sizes and made to measure`}
  description="Shop 3, 5 and 7 ply corrugated boxes in packs, or build any custom size and printing and see the price instantly. Strength (BS) shown, GST invoice, secure online payment."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }}
>
  <section class="hx" data-hx aria-labelledby="hx-title">
    <div class="hx__sticky">
      <div class="hx__grid"></div>
      <div class="hx__word" aria-hidden="true" data-hx-word>{words[0]}</div>
      <div class="hx__meta"><span>{site.name} / box manufacturing</span><span>Designed with purpose. Built for delivery.</span></div>
      <div class="hx__stage" aria-hidden="true" data-hx-stage>
        <div class="hx__orbit"></div>
        <div class="hx__shadow"></div>
        <div class="cbox" data-hx-box>
          <div class="f-back"></div><div class="f-bottom"></div><div class="f-left"></div><div class="f-right"></div>
          <div class="f-front"><span class="mark">{words.map((w, i) => <>{i > 0 && <br />}{w}</>)}<small>Precision in every fold</small></span><span class="code"></span></div>
          <div class="f-top"><div class="flap flap--a"></div><div class="flap flap--b"></div></div>
        </div>
      </div>
      <div class="hx__slides">
        <article class="hx__slide" data-slide>
          <div class="hx-k"><i></i>A better way to package</div>
          <h1 class="hx-h" id="hx-title">Ordinary boxes.<br /><em>Extraordinary</em> thinking.</h1>
          <p>Corrugated cartons that do more than protect. Ready sizes in packs, or any size made to measure and priced in seconds.</p>
          <div class="hx__acts">
            <a class="hx-btn" href="/shop/">Shop boxes <b aria-hidden="true">↗</b></a>
            <a class="hx-link" href="#configure">Build your box ↗</a>
          </div>
        </article>
        <article class="hx__slide" data-slide>
          <div class="hx-k"><i></i>The first impression matters</div>
          <h2 class="hx-h">Make the<br />arrival <em>matter.</em></h2>
          <p>From clean kraft to boxes printed with your logo. Let your box make an impression long before it is opened.</p>
          <div class="hx__acts">
            <a class="hx-btn" href="#configure">Price your box <b aria-hidden="true">↗</b></a>
            <a class="hx-link" href="#quote">Request a quote ↗</a>
          </div>
        </article>
      </div>
      <div class="hx__bottom" aria-hidden="true">
        <div class="hx__cue"><span class="hx__mouse"></span><span>Scroll to discover</span></div>
        <div class="hx__idx"><b data-hx-idx>01 / 02</b> &nbsp; <span data-hx-cap>Designed to impress</span></div>
      </div>
      <div class="hx__bar"><div data-hx-bar></div></div>
    </div>
  </section>

  <div class="hn">
  <section class="promos chap chap--l" data-chapter="promos" data-word="Honey" aria-label="Featured">
    <div class="container"><div class="promos__grid chap-item">
      {promos.map((p) => (
        <a class={`promo promo--${p.tone}`} href={p.href} data-preset={p.preset ? '' : undefined} data-style={p.style} data-print={p.print}>
          <small>{p.kicker}</small>
          <h3>{p.title}</h3>
          <div class="promo__art box3d" aria-hidden="true"><svg viewBox={`0 0 ${BOX_W} ${BOX_H}`} data-carton={cartonData(p.dims, { yaw: p.yaw, pitch: 0.5 })} set:html={boxSvgInner(p.dims, { yaw: p.yaw, pitch: 0.5 }, false)} /></div>
          <b>{p.cta} <span aria-hidden="true">→</span></b>
        </a>
      ))}
    </div></div>
  </section>

  <section class="section chap chap--l" data-chapter="categories" data-word="Packaging" id="products">
    <div class="container">
      <div class="hs chap-move">
        <div><div class="hx-k"><i></i>Shop by type</div><h2 class="hx-h">Packaging <em>categories</em></h2></div>
        <a href="/shop/">View all boxes →</a>
      </div>
      <div class="cats2 chap-item">
        {cats.map((c) => (
          <a class="cat2" href={c.href} data-preset={c.preset ? '' : undefined} data-style={c.style} data-print={c.print}>
            <div class="cat2__img box3d" aria-hidden="true"><svg viewBox={`0 0 ${BOX_W} ${BOX_H}`} data-carton={cartonData(c.dims, { yaw: c.yaw, pitch: 0.5 })} set:html={boxSvgInner(c.dims, { yaw: c.yaw, pitch: 0.5 }, false)} /></div>
            <div class="cat2__name">{c.name}</div>
            <div class="cat2__note">{c.note}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section chap chap--r chap--tint" data-chapter="ready" data-word="Built" data-featured data-built={JSON.stringify([...built])}>
      <div class="container">
        <div class="hs chap-move">
          <div><div class="hx-k"><i></i>Ready to order</div><h2 class="hx-h">Boxes in stock, <em>in packs.</em></h2></div>
          <a href="/shop/">View all boxes →</a>
        </div>
        <div class="tiles chap-item" data-tiles set:html={featured.map((p) => productTile(p, productHref(p, built))).join('')} />
      </div>
    </section>
  )}

  <section class="section chap chap--l" data-chapter="configure" data-word="Custom" id="configure">
    <div class="container">
      <div class="hs chap-move">
        <div><div class="hx-k"><i></i>3D box builder</div><h2 class="hx-h">Design your box.<br /><em>See the price.</em></h2></div>
        <ul class="bb-list">
          {checklist.map((t) => <li><Fragment set:html={icon.check(18)} />{t}</li>)}
        </ul>
      </div>
      <div class="bb chap-item" data-bb>
        <form class="bb__form" data-bb-form onsubmit="return false">
          <div class="bb__head"><span>Custom box builder</span><span data-bb-status>Loading prices…</span></div>
          <div class="bb__q">
            <label for="bb-style"><span><span class="bb__n">01</span>Box style</span></label>
            <select class="input" id="bb-style" name="style">
              <option value="rsc">Regular slotted carton (RSC)</option>
              <option value="diecut">Die-cut mailer box</option>
              <option value="other">Other / not sure</option>
            </select>
          </div>
          <div class="bb__q">
            <div class="bb__lab"><span><span class="bb__n">02</span>Inside size (L × W × H)</span>
              <span class="bb__unit" role="group" aria-label="Unit"><button type="button" data-unit="mm" aria-pressed="true">mm</button><button type="button" data-unit="in" aria-pressed="false">inch</button></span>
            </div>
            <div class="bb__dims">
              <label><small>Length</small><input name="l" inputmode="decimal" value="300" aria-label="Length" /></label><span class="bb__x">×</span>
              <label><small>Width</small><input name="w" inputmode="decimal" value="200" aria-label="Width" /></label><span class="bb__x">×</span>
              <label><small>Height</small><input name="h" inputmode="decimal" value="150" aria-label="Height" /></label>
            </div>
            <p class="bb__help">Inside size of the box. Allow a few mm around your product.</p>
          </div>
          <div class="bb__q">
            <div class="bb__lab"><span><span class="bb__n">03</span>Board strength</span></div>
            <div class="bb__chips" role="group" aria-label="Ply">
              <button type="button" data-ply="3" aria-pressed="false">3 PLY</button>
              <button type="button" data-ply="5" aria-pressed="true">5 PLY</button>
              <button type="button" data-ply="7" aria-pressed="false">7 PLY</button>
            </div>
            <select class="input" name="grade" aria-label="Board grade" data-bb-grade></select>
          </div>
          <div class="bb__q">
            <label for="bb-print"><span><span class="bb__n">04</span>Printing</span></label>
            <select class="input" id="bb-print" name="colours" data-bb-print>
              <option value="0">Plain, no printing</option>
            </select>
          </div>
          <div class="bb__q">
            <label for="bb-qty"><span><span class="bb__n">05</span>Quantity (boxes)</span></label>
            <div class="bb__qty"><button type="button" data-qty="-1" aria-label="100 fewer">−</button><input id="bb-qty" name="qty" inputmode="numeric" value="500" /><button type="button" data-qty="1" aria-label="100 more">+</button></div>
          </div>
        </form>
        <div class="bb__view">
          <figure class="bb__stage" aria-hidden="true" style="margin:0">
            <div class="cbox" data-bb-box>
              <div class="f-back"></div><div class="f-bottom"></div><div class="f-left"></div><div class="f-right"></div>
              <div class="f-front"><span class="mark">{words.map((w, i) => <>{i > 0 && <br />}{w}</>)}</span><span class="code"></span></div>
              <div class="f-top"><div class="flap flap--a"></div><div class="flap flap--b"></div></div>
            </div>
            <figcaption>LIVE PREVIEW</figcaption>
          </figure>
          <div class="bb__sum">
            <div><span>Size</span><strong data-bb-dim>300 × 200 × 150 mm</strong></div>
            <div><span>Board</span><strong data-bb-board>5 ply</strong></div>
            <div><span>Quantity</span><strong data-bb-qty>500 boxes</strong></div>
          </div>
          <div aria-live="polite">
            <div class="bb__price"><strong data-bb-price>…</strong><span data-bb-per></span></div>
            <p class="small muted" data-bb-note style="margin:6px 0 0"></p>
          </div>
          <div class="bb__acts">
            <a class="btn btn--primary" href="/custom-box/" data-bb-order>Order &amp; pay online</a>
            <a class="btn btn--ghost" href="#quote" data-bb-quote>Request a quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section chap chap--r chap--tint" data-chapter="service" data-word="Delivery" aria-label="Why order from us">
    <div class="container">
      <div class="badges chap-item">
        {badges.map((b) => (
          <div class="badge2"><span><Fragment set:html={b.icon} /></span><strong>{b.t}</strong><small>{b.s}</small></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section hq chap chap--l" data-chapter="quote" data-word="Let us build" id="quote">
    <div class="container hq__in">
      <div class="chap-move">
        <div class="hx-k"><i></i>Let’s get started</div>
        <h2 class="hx-h">Good things come in <em>great boxes.</em></h2>
        <p>Have a box in mind, a bulk order or printing? Send us your requirements and we’ll get back to you with a quote.</p>
        <div class="hq__ways">
          {site.whatsapp && <a class="hx-btn" href={waHref(site.whatsapp, `Hi ${site.name}, I'd like a quote for boxes.`)} data-wa="home-quote">WhatsApp us <b aria-hidden="true">↗</b></a>}
          {site.phone && <a class="hx-link" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>Call {site.phone}</a>}
        </div>
      </div>
      <div class="chap-item"><EnquiryForm subject="Quote from the home page box builder" /></div>
    </div>
  </section>

  <section class="section faq chap chap--l" data-chapter="faq" data-word="Packers">
    <div class="container prose">
      <h2 class="chap-move">Frequently asked questions</h2>
      {faqs.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
      {site.whatsapp && <p style="margin-top:18px">Something else? <a href={waHref(site.whatsapp, `Hi ${site.name}, I have a question about boxes.`)} data-wa="faq">Ask us on WhatsApp</a>.</p>}
    </div>
  </section>
  </div>
</Base>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>
