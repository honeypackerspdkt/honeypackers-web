---
import Base from '../layouts/Base.astro';
import { BOX_W, BOX_H, boxSvgInner } from '../lib/box-svg';
import { site, waHref } from '../site';

const heroBox = { length: 400, width: 300, height: 250 };
const check = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

const range = [
  { tag: '3 ply', title: 'Light-duty cartons', text: 'For light goods, retail packs and e-commerce shipping.', items: ['Garments, footwear, FMCG packs', 'Plain or printed', 'Lowest cost per box'] },
  { tag: '5 ply', title: 'Heavy-duty cartons', text: 'Stronger walls for heavier goods and stacking in warehouses.', items: ['Electrical, hardware, food products', 'Better stacking strength', 'Our most ordered range'] },
  { tag: '7 ply', title: 'Extra-heavy cartons', text: 'For heavy, fragile or export loads that travel far.', items: ['Machinery parts, ceramics, export', 'Highest bursting strength', 'Made to your exact size'] },
];

const faqs = [
  { q: 'What is the minimum order?', a: 'The box price page shows the minimum quantity for online prices. For smaller quantities, send an enquiry and we will tell you what we can do.' },
  { q: 'Which size should I give you?', a: 'Give the inside size in millimetres: length and width of the opening, then the height. Allow a few mm around your product for packing.' },
  { q: 'How do I choose 3, 5 or 7 ply?', a: 'Light goods up to a few kg usually travel well in 3 ply. Heavier goods, stacking in warehouses or long transport need 5 ply. Very heavy or export loads need 7 ply. The price page shows the bursting strength (BS) of every option.' },
  { q: 'Is GST included?', a: 'Prices are shown before GST. Corrugated boxes carry 5% GST (HSN 4819), added on the invoice. Give your GSTIN and you can claim input tax credit.' },
  { q: 'Can you print our logo?', a: 'Yes, up to 4 colours. Choose the number of colours on the price page; the plate cost is already included in the price.' },
];
---

<Base
  title={`${site.name}: corrugated boxes made to your size, priced online`}
  description="Corrugated boxes in any size: 3, 5 and 7 ply, plain or printed. Enter your size and quantity to see the price per box, bursting strength and weight instantly."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }}
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="hero__eyebrow">Corrugated box manufacturer</span>
        <h1>Boxes made to your size. Price in seconds.</h1>
        <p class="hero__lead">Tell us the size, ply and quantity. You'll see the price per box, how strong it is and what it weighs, before you call anyone.</p>
        <ul class="hero__points">
          <li><Fragment set:html={check} />3, 5 and 7 ply, any size</li>
          <li><Fragment set:html={check} />Plain or printed with your logo, up to 4 colours</li>
          <li><Fragment set:html={check} />GST invoice with every order</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href="/custom-box/">Price your box</a>
          {site.whatsapp ? <a class="btn btn--whatsapp" href={waHref(site.whatsapp, `Hi ${site.name}, I need corrugated boxes.`)} data-wa="hero">WhatsApp us</a> : <a class="btn btn--ghost" href="/contact/">Send an enquiry</a>}
        </div>
      </div>
      <a class="hero__visual box3d" href="/custom-box/" aria-label="Open the box price calculator">
        <svg viewBox={`0 0 ${BOX_W} ${BOX_H}`} aria-hidden="true" set:html={boxSvgInner(heroBox, { yaw: -0.62, pitch: 0.5 })} />
      </a>
    </div>
  </section>

  <section class="section section--tint" id="range">
    <div class="container">
      <h2>Boxes we make</h2>
      <p class="section__intro">Regular slotted cartons (the standard brown shipping box) in the size you need. Every box is made to order.</p>
      <div class="grid grid--3">
        {range.map((r) => (
          <article class="card range-card">
            <span class="tag">{r.tag}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <ul>{r.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How ordering works</h2>
      <ol class="steps">
        <li><h3>Enter your size</h3><p>Inside length, width and height, the board grade and the quantity.</p></li>
        <li><h3>See the price</h3><p>Price per box, bursting strength and weight, and how much you save on bigger orders.</p></li>
        <li><h3>Confirm</h3><p>Send it on WhatsApp or as an enquiry. We confirm the details and the delivery date.</p></li>
        <li><h3>We make and deliver</h3><p>Your boxes are made to order and delivered with a GST invoice.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container grid grid--3">
      <div class="feature">
        <div class="feature__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 10h2M12 10h2M16 10h0M8 14h2M12 14h2M8 18h8"/></svg></div>
        <h3>Honest, open pricing</h3>
        <p>The price comes from the paper in your box, the same calculation we use in the factory.</p>
      </div>
      <div class="feature">
        <div class="feature__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="m3 7 9 5 9-5M12 12v10"/></svg></div>
        <h3>Strength you can check</h3>
        <p>Every option shows its bursting strength (BS), so you pick the right ply instead of guessing.</p>
      </div>
      <div class="feature">
        <div class="feature__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg></div>
        <h3>GST invoice</h3>
        <p>Proper tax invoice with HSN and GST, so business buyers can claim input tax credit.</p>
      </div>
    </div>
  </section>

  <section class="section faq">
    <div class="container prose">
      <h2>Questions</h2>
      {faqs.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>

  <section class="container">
    <div class="cta-band">
      <div>
        <h2>Need boxes? See your price now.</h2>
        <p>Any size, 3 to 7 ply, plain or printed.</p>
      </div>
      <a class="btn btn--primary" href="/custom-box/" style="background:#fff;color:var(--ink)">Price your box</a>
    </div>
  </section>
</Base>
