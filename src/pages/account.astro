---
import Base from '../layouts/Base.astro';
import SignInFields from '../components/SignInFields.astro';
import AddressFields from '../components/AddressFields.astro';
import { site } from '../site';
import { icon } from '../lib/icons';
const enabled = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY && import.meta.env.PUBLIC_SHOP_ORG_ID);
---

<Base title="Your account" description={`Sign in or create your ${site.name} account to order, see your orders, download GST invoices and keep your delivery address.`}>
  <section class="section" style="padding-top:32px">
    <div class="container" style="max-width:980px" data-account data-enabled={enabled ? '1' : ''} data-wa={site.whatsapp} data-name={site.name}>
      <div data-view="off" hidden>
        <h1>Your account</h1>
        <p class="card">Online accounts open soon. Until then, <a href="/contact/">send us an enquiry</a>{site.whatsapp && <> or <a href={`https://wa.me/${site.whatsapp}`} data-wa="account">WhatsApp us</a></>} for your order status and invoices.</p>
      </div>

      <div data-view="loading"><p class="muted">Loading…</p></div>

      <!-- signed out: one card for sign in and sign up (a code; the account is made on first sign-in) -->
      <form class="card form-grid auth" data-view="phone" hidden novalidate>
        <div>
          <h1 class="auth__title">Sign in or create account</h1>
          <p class="muted small" style="margin:6px 0 0">New to {site.name}? Your account is created when you confirm the code. No password needed.</p>
        </div>
        <SignInFields />
        <p class="notice" data-error hidden></p>
        <button class="btn btn--primary btn--block" type="submit">Continue</button>
        <p class="small muted" style="margin:0">By continuing you agree to our <a href="/terms/">terms</a> and <a href="/privacy/">privacy policy</a>.</p>
      </form>

      <form class="card form-grid auth" data-view="code" hidden novalidate>
        <div>
          <h1 class="auth__title">Enter the code</h1>
          <p class="muted small" style="margin:6px 0 0">Sent to <strong data-mobile></strong> · <button type="button" class="linkish" data-change>Change</button></p>
        </div>
        <p class="muted small" style="margin:0" data-code-hint></p>
        <label class="field">
          <span>6-digit code</span>
          <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required style="letter-spacing:.3em" />
        </label>
        <p class="notice" data-error hidden></p>
        <button class="btn btn--primary btn--block" type="submit">Sign in</button>
        <button class="btn btn--ghost btn--block" type="button" data-resend>Send the code again</button>
      </form>

      <!-- signed in -->
      <div data-view="account" hidden>
        <div class="acc-head">
          <div>
            <h1 style="margin:0" data-hello>Your account</h1>
            <p class="muted" style="margin:4px 0 0" data-who></p>
          </div>
        </div>
        <p class="notice notice--ok" data-flash hidden></p>

        <div class="acc">
          <nav class="acc__nav" aria-label="Account">
            <a href="#orders" data-tab="orders"><Fragment set:html={icon.cart(18)} />My orders</a>
            <a href="#profile" data-tab="profile"><Fragment set:html={icon.user(18)} />Profile &amp; address</a>
            <button type="button" data-signout>Sign out</button>
          </nav>

          <div>
            <section data-panel="orders">
              <div data-orders></div>
              <div class="btn-row" style="margin-top:8px">
                <a class="btn btn--primary" href="/shop/">Shop boxes</a>
                <a class="btn btn--ghost" href="/custom-box/">Price a custom box</a>
              </div>
            </section>

            <section data-panel="profile" hidden>
              <form class="form-grid" data-profile novalidate>
                <div class="card form-grid">
                  <div>
                    <h2 style="font-size:1.2rem;margin:0" data-profile-title>Your details</h2>
                    <p class="muted small" style="margin:4px 0 0">Filled in for you at checkout. Add your GSTIN to claim input tax credit.</p>
                  </div>
                  <div class="form-grid form-grid--2 stack-sm">
                    <label class="field"><span>Your name</span><input name="name" autocomplete="name" maxlength="80" required /></label>
                    <label class="field"><span>Company <small>(optional)</small></span><input name="company" autocomplete="organization" maxlength="120" /></label>
                  </div>
                  <div class="form-grid form-grid--2 stack-sm">
                    <label class="field"><span>E-mail <small>(for invoices)</small></span><input name="email" type="email" autocomplete="email" maxlength="120" /></label>
                    <label class="field" data-need-phone hidden><span>Mobile number <small>(for delivery)</small></span><input name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder="98765 43210" /></label>
                    <label class="field"><span>GSTIN <small>(optional)</small></span><input name="gstin" maxlength="15" style="text-transform:uppercase" /></label>
                  </div>
                </div>
                <div class="card form-grid">
                  <div>
                    <h2 style="font-size:1.2rem;margin:0">Delivery address</h2>
                    <p class="muted small" style="margin:4px 0 0">Used for your next order. You can change it at checkout too.</p>
                  </div>
                  <AddressFields pincode />
                </div>
                <p class="notice" data-error hidden></p>
                <div class="btn-row"><button class="btn btn--primary" type="submit">Save changes</button></div>
              </form>
            </section>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initAccount } from '../scripts/account';
  const root = document.querySelector<HTMLElement>('[data-account]');
  if (root) void initAccount(root);
</script>
