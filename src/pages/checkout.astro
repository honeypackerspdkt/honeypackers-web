---
import Base from '../layouts/Base.astro';
import { GST_STATES } from '@honeypackers/box-core/gst';
import { site } from '../site';
const live = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY && import.meta.env.PUBLIC_SHOP_ORG_ID);
---

<Base title="Checkout" description="Your boxes, delivery, GST and secure online payment.">
  <section class="container" style="padding-top:24px" data-checkout data-live={live ? '1' : ''} data-wa={site.whatsapp} data-name={site.name}>
    <h1 style="margin-bottom:16px">Checkout</h1>
    <div data-empty hidden class="card"><p style="margin:0">Your cart is empty. <a href="/shop/">Shop boxes</a> or <a href="/custom-box/">price a custom size</a>.</p></div>
    <div class="checkout" data-full hidden>
      <div>
        <div class="step">
          <h2><span class="num">1</span>Your boxes</h2>
          <div data-lines></div>
          <p class="notice small" data-problems hidden style="margin:10px 0 0"></p>
        </div>

        <div class="step">
          <h2><span class="num">2</span>Delivery</h2>
          <div class="form-grid">
            <label class="field" style="max-width:240px"><span>Pincode</span><input name="pincode" inputmode="numeric" maxlength="6" autocomplete="postal-code" placeholder="e.g. 622001" /></label>
            <p class="small" data-deliv style="margin:0"></p>
            <label class="field"><span>Delivery address</span><textarea name="address" rows="3" maxlength="400" autocomplete="street-address"></textarea></label>
          </div>
        </div>

        <div class="step" data-step-details>
          <h2><span class="num">3</span>Your details</h2>
          <div data-off hidden>
            <p style="margin:0 0 12px">Online payment opens soon. Send this order to us and we'll confirm it with you.</p>
            <div class="btn-row">
              {site.whatsapp && <a class="btn btn--whatsapp" href="#" data-wa-order data-wa="checkout" rel="noopener">Send order on WhatsApp</a>}
              <a class="btn btn--ghost" href="/contact/" data-enquiry-link>Send as enquiry</a>
            </div>
          </div>
          <form data-phone hidden class="form-grid" novalidate>
            <p class="muted small" style="margin:0">Sign in with your mobile number to pay and to see your orders and invoices later. We'll send a 6-digit code by SMS.</p>
            <label class="field"><span>Mobile number</span>
              <span style="display:flex;gap:8px"><span class="input" style="width:64px;display:grid;place-items:center;color:var(--ink-soft)">+91</span><input name="mobile" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder="98765 43210" /></span>
            </label>
            <div><button class="btn btn--primary" type="submit">Send code</button></div>
          </form>
          <form data-code hidden class="form-grid" novalidate>
            <p style="margin:0">Code sent to <strong data-mobile></strong>. <button type="button" class="linkish" data-change>Change</button></p>
            <label class="field"><span>6-digit code</span><input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" style="letter-spacing:.3em;max-width:200px" /></label>
            <div class="btn-row"><button class="btn btn--primary" type="submit">Verify</button><button type="button" class="btn btn--ghost" data-resend>Send again</button></div>
          </form>
          <div data-details hidden class="form-grid">
            <p class="small muted" style="margin:0" data-who></p>
            <div class="form-grid form-grid--2 stack-sm">
              <label class="field"><span>Your name</span><input name="name" autocomplete="name" maxlength="80" /></label>
              <label class="field"><span>Company <small>(optional)</small></span><input name="company" autocomplete="organization" maxlength="120" /></label>
            </div>
            <div class="form-grid form-grid--2 stack-sm">
              <label class="field"><span>GSTIN <small>(optional, for input tax credit)</small></span><input name="gstin" maxlength="15" style="text-transform:uppercase" /></label>
              <label class="field"><span>State</span><select name="stateCode"><option value="">Choose…</option>{Object.entries(GST_STATES).map(([code, name]) => <option value={code}>{name}</option>)}</select></label>
            </div>
            <label class="field"><span>E-mail <small>(optional, for the invoice)</small></span><input name="email" type="email" autocomplete="email" maxlength="120" /></label>
          </div>
          <p class="notice small" data-err hidden style="margin:12px 0 0"></p>
        </div>
      </div>

      <aside class="summary">
        <div class="card">
          <h2 style="font-size:1.15rem;margin:0 0 12px">Order summary</h2>
          <dl class="kv">
            <dt>Boxes</dt><dd data-goods>—</dd>
            <dt>Delivery</dt><dd data-delivery>Enter pincode</dd>
            <dt>GST 5%</dt><dd data-gst>—</dd>
            <dt class="total">Total</dt><dd class="total" data-total>—</dd>
          </dl>
          <button class="btn btn--primary btn--block" type="button" data-pay disabled style="margin-top:16px">Pay securely</button>
          <p class="small muted" data-pay-why style="margin:8px 0 0"></p>
          <p class="small muted" style="margin:12px 0 0">Payments by Razorpay: UPI, cards and net banking. You get a GST invoice with your order. By paying you agree to our <a href="/terms/">terms</a>, <a href="/refund/">refund</a> and <a href="/shipping/">delivery</a> policies.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { initCheckout } from '../scripts/checkout';
  const root = document.querySelector<HTMLElement>('[data-checkout]');
  if (root) void initCheckout(root);
</script>
