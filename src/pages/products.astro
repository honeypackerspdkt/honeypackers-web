---
import Base from '../layouts/Base.astro';
import { loadProducts } from '../lib/products';
import { liveConfig } from '../lib/price-list';
import { productCard } from '../lib/product-card';

// Built with the products at build time (good for search engines); the script refreshes them live.
const { products, source } = await loadProducts(liveConfig());
---

<Base title="Corrugated boxes in packs: buy online" description="Ready sizes of 3 and 5 ply corrugated boxes in packs. See the price per pack and per box, add to cart and pay online.">
  <section class="section" style="padding-top:32px">
    <div class="container" data-products-page data-source={source}>
      <h1>Boxes in packs</h1>
      <p class="section__intro">Popular sizes, ready to order in packs. Need another size? <a href="/custom-box/">Price any size here</a>.</p>
      {source === 'sample' && <p class="notice" data-sample-note>These are <strong>sample products and prices</strong> while our shop is being set up.</p>}
      <div class="products" data-list set:html={products.map(productCard).join('')} />
      {products.length === 0 && <p class="card">No ready sizes online right now. <a href="/custom-box/">Price your box</a> or <a href="/contact/">send an enquiry</a>.</p>}
      <div class="cart-bar" data-cart-bar hidden><a class="btn btn--primary" href="/cart/" data-cart-link>Cart</a></div>
    </div>
  </section>
</Base>

<script>
  import type { Product } from '@honeypackers/box-core/types';
  import { addToCart, cartCount, loadProducts, readCart, writeCart } from '../lib/products';
  import { liveConfig } from '../lib/price-list';
  import { productCard } from '../lib/product-card';

  const root = document.querySelector<HTMLElement>('[data-products-page]')!;
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  const bar = root.querySelector<HTMLElement>('[data-cart-bar]')!;
  const showBar = () => {
    const n = cartCount(readCart());
    bar.hidden = n === 0;
    root.querySelector('[data-cart-link]')!.textContent = `Cart · ${n} pack${n === 1 ? '' : 's'} →`;
  };
  let products: Product[] = [];

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-add]');
    if (!btn) return;
    const card = btn.closest<HTMLElement>('[data-product]')!;
    const packQty = Number(card.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value);
    const count = Math.max(1, Math.min(1000, Math.floor(Number(card.querySelector<HTMLInputElement>('[data-count]')!.value) || 1)));
    writeCart(addToCart(readCart(), { productId: card.dataset.product!, packQty, count }));
    btn.textContent = 'Added ✓';
    setTimeout(() => (btn.textContent = 'Add to cart'), 1500);
    showBar();
  });
  window.addEventListener('cart-change', showBar);
  showBar();

  // Refresh with live products (stock and prices may have changed since the site was built).
  void loadProducts(liveConfig()).then((r) => {
    if (r.source !== 'live') return;
    products = r.products;
    list.innerHTML = products.map(productCard).join('');
    root.querySelector<HTMLElement>('[data-sample-note]')?.remove();
  });
</script>
