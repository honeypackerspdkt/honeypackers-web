---
import Base from '../layouts/Base.astro';
import { samplePriceList } from '../lib/price-list';
import { gradeLabel } from '@honeypackers/box-core/pricing';
import { BOX_W, BOX_H, boxSvgInner, boxLabel } from '../lib/box-svg';
import { defaultView } from '@honeypackers/box-core/box3d';
import { site } from '../site';

// Grades are rendered from the sample list so the page works without JavaScript; the script
// swaps in the live list (Supabase) when it is configured.
const { shop } = samplePriceList();
const start = { length: 300, width: 200, height: 150 };
const prints = [
  { id: 'plain', label: 'Plain' },
  { id: 'one', label: '1 colour' },
  { id: 'multi', label: 'Multicolour' },
];
const live = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SHOP_ORG_ID);
---

<Base
  title="Corrugated box price calculator: any size, instant price"
  description="Enter your box size, ply and quantity to see the price per box, bursting strength (BS) and weight straight away. 3, 5 and 7 ply corrugated boxes, plain or printed."
>
  <section class="section" style="padding-top:32px">
    <div class="container">
      <h1>Price your box</h1>
      <p class="section__intro">Enter the inside size of the box you need. You'll see the price per box, how strong it is and what it weighs, and how the price drops as you order more.</p>
      {!live && <p class="notice" data-sample-note>These are <strong>sample prices</strong> while our live price list is being set up. Send an enquiry for a firm quote.</p>}

      <div class="config" data-config data-wa={site.whatsapp} data-name={site.name} data-live={live ? '1' : ''}>
        <form class="config__panel" data-form onsubmit="return false">
          <div class="card form-grid">
            <h2 style="font-size:1.2rem;margin:0">1. Size (inside, in mm)</h2>
            <div class="form-grid form-grid--3">
              {(['length', 'width', 'height'] as const).map((k) => (
                <label class="field">
                  <span>{k[0].toUpperCase() + k.slice(1)}</span>
                  <span class="input-unit"><input name={k} type="number" inputmode="decimal" min="50" max="3000" step="1" value={start[k]} required /><em>mm</em></span>
                </label>
              ))}
            </div>
            <p class="small muted" style="margin:0">Measure the inside: length and width of the opening, height from bottom to top.</p>
          </div>

          <div class="card form-grid">
            <h2 style="font-size:1.2rem;margin:0">2. Board strength</h2>
            <label class="field">
              <span>Grade</span>
              <select name="grade" data-grades>
                {shop.rules.grades.map((g) => <option value={g.id}>{g.label || gradeLabel(g)}</option>)}
              </select>
              <small>3 ply for light goods, 5 ply for heavier goods and stacking, 7 ply for heavy or export loads.</small>
            </label>
          </div>

          <div class="card form-grid">
            <h2 style="font-size:1.2rem;margin:0">3. Printing</h2>
            <div class="chips" role="radiogroup" aria-label="Printing" data-colours>
              {prints.map((p) => (
                <label><input type="radio" name="print" value={p.id} checked={p.id === 'plain'} /><span>{p.label}</span></label>
              ))}
            </div>
            <p class="small muted" style="margin:0" data-print-note>Plain kraft box, no printing.</p>

            <div class="art" data-art hidden>
              <div class="art__tools">
                <label class="btn btn--ghost btn--sm art__file"><input type="file" accept="image/png,image/jpeg,image/webp" data-art-file />Add logo</label>
                <button type="button" class="btn btn--ghost btn--sm" data-art-addtext>Add text</button>
                <label class="art__ink">Ink <select data-art-ink></select></label>
              </div>
              <div class="art__sides" role="group" aria-label="Side of the box to design" data-art-sides></div>
              <div class="art__stage"><canvas data-art-canvas tabindex="0" aria-label="Front of the box. Drag your logo and text into place; arrow keys move the selected item."></canvas></div>
              <p class="small muted art__help">Pick a side, add your logo or text and drag it into place (orange corner to resize). The 3D box shows every side. <a class="art__see" href="#box3d">See it on the 3D box ↓</a> <span data-art-hint></span></p>
              <div class="art__edit" data-art-edit hidden>
                <label class="field" data-art-textwrap><span>Text</span><input data-art-text maxlength="60" /></label>
                <label class="field"><span>Size</span><input type="range" min="5" max="100" data-art-size /></label>
                <label class="field" data-art-colorwrap><span>Colour</span><select data-art-color></select></label>
                <button type="button" class="btn btn--ghost btn--sm" data-art-delete>Remove</button>
              </div>
            </div>
          </div>

          <div class="card form-grid">
            <h2 style="font-size:1.2rem;margin:0">4. Quantity and delivery</h2>
            <div class="form-grid form-grid--2">
              <label class="field"><span>Quantity</span><span class="input-unit"><input name="qty" type="number" inputmode="numeric" min="1" step="1" value="500" required /><em>pcs</em></span></label>
              <label class="field"><span>Delivery pincode</span><input name="pincode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="e.g. 600001" autocomplete="postal-code" /></label>
            </div>
          </div>
        </form>

        <aside class="config__aside" aria-live="polite">
          <div class="card box3d" style="padding:12px;scroll-margin-top:140px" id="box3d">
            <svg viewBox={`0 0 ${BOX_W} ${BOX_H}`} role="img" tabindex="0" aria-label={boxLabel(start)} data-box set:html={boxSvgInner(start, defaultView)} />
            <div class="box3d__caption"><span data-box-caption>{start.length} × {start.width} × {start.height} mm (L × W × H)</span><span>Drag to turn</span></div>
          </div>

          <div class="card" data-result>
            <div data-ok>
              <p class="muted small" style="margin:0 0 4px">Price per box</p>
              <p class="price-big" style="margin:0"><span data-unit>—</span> <small>+ GST</small></p>
              <p class="spec-line" data-spec style="margin:8px 0 16px"></p>
              <dl class="kv">
                <dt data-qty-label>Boxes</dt><dd data-amount>—</dd>
                <dt>Delivery</dt><dd data-delivery>Enter pincode</dd>
                <dt data-gst-label>GST 5%</dt><dd data-gst>—</dd>
                <dt class="total">Total</dt><dd class="total" data-total>—</dd>
              </dl>
              <p class="small muted" data-delivery-note style="margin:10px 0 0"></p>
              <p class="notice" data-buy-msg hidden style="margin:12px 0 0"></p>
            </div>
            <div data-bad hidden>
              <p class="notice" data-bad-msg style="margin:0 0 12px"></p>
              <p class="small muted" style="margin:0">We can still make it: send the details and we'll quote by phone or WhatsApp.</p>
            </div>
            <div data-noprice hidden>
              <p style="margin:0">Send us your size and quantity and we'll reply with a quote.</p>
            </div>
            <div class="btn-row" style="margin-top:18px">
              {live && <button class="btn btn--primary" type="button" data-buy hidden>Order &amp; pay online</button>}
              {site.whatsapp && <a class="btn btn--whatsapp" href="#" data-wa-order data-wa="configurator" rel="noopener">Order on WhatsApp</a>}
              <a class="btn btn--ghost" href="/contact/" data-enquiry-link>Send as enquiry</a>
            </div>
          </div>

          <div class="card" data-slabs-card>
            <h2 style="font-size:1.1rem;margin:0 0 8px">Order more, pay less</h2>
            <table class="slab-table">
              <thead><tr><th>Quantity</th><th>Per box</th></tr></thead>
              <tbody data-slabs></tbody>
            </table>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container prose">
      <h2>How the price is worked out</h2>
      <p>The price comes from the paper in your box: we work out the board sheet size from your measurements, the weight of each paper layer (the fluted layers use about 40% more paper), and add converting, printing and our margin. Bigger orders get a lower margin. This is the same calculation we use in our factory, so the price you see is the price you pay. GST at 5% (HSN 4819) is added on top.</p>
      <h2>What is BS?</h2>
      <p>Bursting strength (BS, in kg/cm²) tells you how much pressure the board takes before it bursts. It comes from the GSM and BF of each paper layer. The price above shows the BS of the board you pick, so you can compare grades.</p>
    </div>
  </section>
</Base>

<script>
  import { initConfigurator } from '../scripts/configurator';
  const root = document.querySelector<HTMLElement>('[data-config]');
  if (root) initConfigurator(root);
</script>
