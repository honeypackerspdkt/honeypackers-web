---
import { site, telHref, waHref } from '../site';
import { icon } from '../lib/icons';
const year = new Date().getFullYear();
---

<section class="trust-strip" aria-label="Why buy from us">
  <div class="container trust-strip__grid">
    <div><Fragment set:html={icon.ruler(26)} /><strong>Any size</strong><span>Made to your measurements</span></div>
    <div><Fragment set:html={icon.layers(26)} /><strong>Strength shown</strong><span>BS and weight for every box</span></div>
    <div><Fragment set:html={icon.receipt(26)} /><strong>GST invoice</strong><span>Claim input tax credit</span></div>
    <div><Fragment set:html={icon.shield(26)} /><strong>Secure payment</strong><span>UPI, cards, net banking</span></div>
  </div>
</section>
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid site-footer__grid--4">
      <div>
        <h2>{site.name}</h2>
        <p>{site.tagline}. 3, 5 and 7 ply corrugated boxes, plain or printed.</p>
        {site.address && <p>{site.address}{site.city && `, ${site.city}`}</p>}
        {site.gstin && <p>GSTIN {site.gstin}</p>}
      </div>
      <div>
        <h2>Shop</h2>
        <ul>
          <li><a href="/shop/">All boxes</a></li>
          <li><a href="/shop/?ply=3">3 ply boxes</a></li>
          <li><a href="/shop/?ply=5">5 ply boxes</a></li>
          <li><a href="/custom-box/">Custom size &amp; printing</a></li>
        </ul>
      </div>
      <div>
        <h2>Help</h2>
        <ul>
          <li><a href="/account/">My orders</a></li>
          <li><a href="/contact/">Bulk orders &amp; enquiries</a></li>
          <li><a href="/privacy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms &amp; conditions</a></li>
          <li><a href="/refund/">Cancellation &amp; refunds</a></li>
          <li><a href="/shipping/">Shipping &amp; delivery</a></li>
        </ul>
      </div>
      <div>
        <h2>Talk to us</h2>
        <ul>
          {site.phone && <li><a href={telHref(site.phone)}>{site.phone}</a></li>}
          {site.whatsapp && <li><a href={waHref(site.whatsapp)} data-wa="footer">WhatsApp</a></li>}
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          <li><a href="/contact/">Send an enquiry</a></li>
        </ul>
      </div>
    </div>
    <p class="site-footer__legal">© {year} {site.name}. Prices are shown before GST. Corrugated boxes (HSN 4819) carry 5% GST.</p>
  </div>
</footer>
