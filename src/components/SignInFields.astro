---
/** Sign-in target picker shared by My orders and checkout: a code on WhatsApp (mobile) or by e-mail. See lib/signin-form.ts. */
---

<fieldset class="via">
  <legend class="visually-hidden">Get the sign-in code by</legend>
  <label class="via__opt"><input type="radio" name="via" value="wa" checked /> WhatsApp</label>
  <label class="via__opt"><input type="radio" name="via" value="email" /> E-mail</label>
</fieldset>
<label class="field" data-via-field="wa">
  <span>Mobile number <small>(on WhatsApp)</small></span>
  <span style="display:flex;gap:8px">
    <span class="input" style="width:64px;display:grid;place-items:center;color:var(--ink-soft)">+91</span>
    <input name="mobile" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder="98765 43210" />
  </span>
</label>
<label class="field" data-via-field="email" hidden>
  <span>E-mail</span>
  <input name="signin_email" type="email" autocomplete="email" maxlength="120" placeholder="you@company.com" />
</label>
<p class="muted small" style="margin:0" data-via-note>We'll send a 6-digit code on WhatsApp. No password needed.</p>
