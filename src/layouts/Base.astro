---
import '@rajesh-hub/tokens/web.css';
import '../styles/brand.css';
import ConsentBanner from '@rajesh-hub/web-growth/components/ConsentBanner.astro';
import WhatsAppFloat from '@rajesh-hub/web-growth/components/WhatsAppFloat.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { brandColor } from '../lib/theme';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD for this page. */
  jsonLd?: Record<string, unknown>;
}
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const brand = brandColor(import.meta.env.PUBLIC_BRAND_COLOR);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// Only facts that are filled in go into the business card for search engines.
const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.tagline,
  url: site.url,
  ...(site.phone && { telephone: site.phone }),
  ...(site.email && { email: site.email }),
  ...(site.address && { address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: site.city || undefined, addressCountry: 'IN' } }),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={brand} />
    <style is:inline set:html={`:root:root{--brand:${brand}}`}></style>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta+Malar:wght@400;600;700&family=Playfair+Display:wght@600;700&family=Noto+Serif+Tamil:wght@600&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <CartDrawer />
    {site.whatsapp && <WhatsAppFloat phone={site.whatsapp} label="WhatsApp" greeting={`Hi ${site.name}, I need corrugated boxes.`} />}
    <ConsentBanner
      text="We use cookies to see which of our ads bring visitors."
      accept="Accept"
      decline="No thanks"
      privacyHref="/privacy/"
      privacyLabel="Privacy policy"
    />
    <script>
      import { initTracking } from '@rajesh-hub/web-growth';
      initTracking();
    </script>
  </body>
</html>
